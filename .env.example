# AgriGuide AI — environment configuration template.
# Copy to .env and fill in values. NEVER commit .env (it is gitignored).

# --- Hugging Face ----------------------------------------------------------
# Required to download the GATED IndicTrans2 checkpoints (auto-approve gate).
# Create a token at https://huggingface.co/settings/tokens and accept the
# license on each model page:
#   https://huggingface.co/ai4bharat/indictrans2-en-indic-dist-200M
#   https://huggingface.co/ai4bharat/indictrans2-indic-en-dist-200M
HF_TOKEN=

# --- Models ----------------------------------------------------------------
# Embeddings: MIT-licensed, covers en + hi + kn (Kannada) — see docs/model_selection.md
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Domain LLM placeholders: BharatGen AgriParam (en/hi only). UNUSED by the
# application: AgriParam was evaluated but NOT integrated (it failed the
# accuracy criteria; the professor's requirement remains unmet). Its licence
# is unresolved. See docs/model_selection.md. LLM_MODEL, LLM_DTYPE and
# LLM_MAX_NEW_TOKENS are not used by any code path (answers are extractive).
# LLM_DEVICE IS used: src/build_index.py passes it as the embedding device when
# building the index (the app itself always loads the embedder on "cpu"). Keep
# it; do not rename or remove it.
LLM_MODEL=bharatgenai/AgriParam
LLM_DEVICE=cpu
LLM_DTYPE=bfloat16
LLM_MAX_NEW_TOKENS=200

# --- Translation -----------------------------------------------------------
# NOTE: INDIC_TRANSLATOR_BACKEND is read into src/config.py but no code path
# uses it; translation always goes through the worker process described in
# docs/indictrans2_environment.md. Backend selection (docs/model_selection.md):
#   shim = Windows-native preprocessing adaptation (default)
#   wsl  = official IndicTransToolkit running in WSL2 sidecar
INDIC_TRANSLATOR_BACKEND=shim

# --- Retrieval -------------------------------------------------------------
FAISS_INDEX_PATH=data/processed/faiss_index.bin
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K=5
# Minimum cosine similarity for retrieved text to count as evidence
# (abstention gate). Provisional — calibrate before evaluation.
MIN_SCORE=0.40

# --- App -------------------------------------------------------------------
SUPPORTED_LANGUAGES=en,hi,kn
LOG_LEVEL=INFO
SEED=42
