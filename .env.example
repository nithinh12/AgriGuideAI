# AgriGuide AI — environment configuration template.
# Copy to .env and fill in values. NEVER commit .env (it is gitignored).

# --- Hugging Face ----------------------------------------------------------
# Required to download the GATED IndicTrans2 checkpoints (auto-approve gate).
# Create a token at https://huggingface.co/settings/tokens and accept the
# license on each model page:
#   https://huggingface.co/ai4bharat/indictrans2-en-indic-dist-200M
#   https://huggingface.co/ai4bharat/indictrans2-indic-en-dist-200M
HF_TOKEN=

# --- Models ----------------------------------------------------------------
# Embeddings: MIT-licensed, covers en + hi + kn (Kannada) — see docs/model_selection.md
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Domain LLM: BharatGen AgriParam (Apache-2.0, en/hi only)
LLM_MODEL=bharatgenai/AgriParam
LLM_DEVICE=cpu
LLM_DTYPE=bfloat16
LLM_MAX_NEW_TOKENS=200

# --- Translation -----------------------------------------------------------
# Backend selection (docs/model_selection.md):
#   shim = Windows-native preprocessing adaptation (default)
#   wsl  = official IndicTransToolkit running in WSL2 sidecar
INDIC_TRANSLATOR_BACKEND=shim

# --- Retrieval -------------------------------------------------------------
FAISS_INDEX_PATH=data/processed/faiss_index.bin
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K=5
# Minimum cosine similarity for retrieved text to count as evidence
# (abstention gate). Provisional — calibrate before evaluation.
MIN_SCORE=0.40

# --- App -------------------------------------------------------------------
SUPPORTED_LANGUAGES=en,hi,kn
LOG_LEVEL=INFO
SEED=42
